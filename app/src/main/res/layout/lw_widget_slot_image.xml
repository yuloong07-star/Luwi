<?xml version="1.0" encoding="utf-8"?>
<!--
  图文槽那一格 (方案 3.1): 一张图 + 标题 + 正文 + 最多两颗按钮

  番茄钟 / 状态卡 / 快捷入口那一类都住这个形状里; 两颗按钮里 `action: "tool"` 那一颗点下去会调
  插件自己的一条工具 (见 `WidgetActionReceiver`)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lw_slot_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E60C0F14"
    android:orientation="vertical"
    android:padding="10dp">

    <ImageView
        android:id="@+id/lw_slot_image_pic"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/lw_slot_image_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/lw_slot_image_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="3"
        android:textColor="#CCFFFFFF"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/lw_slot_image_btn1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp" />

        <Button
            android:id="@+id/lw_slot_image_btn2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>
