<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The host binds loopback, and a later setting will bind another interface so other
         devices can reach the GUI, so INTERNET covers both -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The dsh host and the WebView both have to survive the app going to the background -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 通知越过锁屏弹成横幅 (lw_notify 的 banner)。Android 14 起这条对非闹钟/通话类的应用**默认
         不给**: 声明了系统也不一定给, 要人去 `设置 -> 应用 -> 特殊应用权限 -> 全屏通知` 手动开。
         所以 `lw_notify` 会去问 `canUseFullScreenIntent()` 并把真实答案说出来, 不假装横幅成了 -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- The workspace has to be a real path: dsh runs as a Node child process and works in
         directories, and a storage-access-framework grant only reaches this process's
         ContentResolver. Without this the workspace falls back to the app's own media
         directory, which needs no permission but is not the shared /sdcard the user browses.
         Granted by hand in system settings, so the ScopedStorage lint is expected -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- 前台服务的类型: 一条权限对一种类型, 用不到的类型系统不会拦, 但少一条就会在起服务时拒。
         mediaProjection 是录屏那条 (1.0.3), connectedDevice 是蓝牙, 其余对应用途一看就懂 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- 通知与触感: lw_notify / lw_vibrate 用的就是这两条 -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 设备与交互: 拍照、录音、手电、身体传感器与活动识别, 都由对应的 lw_* 工具在运行时先过权限闸 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- MODIFY_AUDIO_SETTINGS 不是为了自己改音频设置, 而是 **WebView 要它才肯给录音设备**:
         Chromium 的 cr_media 在枚举/选中输入设备时同时查 RECORD_AUDIO 与这一条, 少一条就
         "No audio device will be available for recording" —— 表现是草稿框那个麦克风按钮点了报
         could not start, 而权限页面上看 RECORD_AUDIO 明明是给的 (2026-10-05 在 vivo 上实测:
         日志原话就是 Requires MODIFY_AUDIO_SETTINGS and RECORD_AUDIO)。普通权限, 装完即有 -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FLASHLIGHT" />
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />

    <!-- 网络与连接: lw_net 读状态、改开关, 蓝牙那几条给连接设备与后续的传输用。
         NEARBY_WIFI_DEVICES 是 Android 13 起扫描/连接邻近 WiFi 要的那条 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.READ_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SYNC_SETTINGS" />

    <!-- 位置与媒体: lw_location 与分享/下载那几条要从公共目录读文件, 所以媒体那几条一起要 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <!-- 特殊访问: 这几条装上就有, 但**要人去系统页或 adb 里点一次**才生效。
         WRITE_SETTINGS 给 lw_system 里那些受保护的项, SYSTEM_ALERT_WINDOW 给以后要用的悬浮层,
         PACKAGE_USAGE_STATS 给"最近任务/占用"那类查询, REQUEST_IGNORE_BATTERY_OPTIMIZATIONS 是
         host 常驻的前提, 精确闹钟给定时任务, 装/卸那两条给 lw_app_control (1.0.3) -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.DELETE_PACKAGES" />
    <!-- 桌面组件那两格 (插件方案 v2 的 3.1): 开机 / 解锁 / 覆盖安装之后要把帧图的读权限补还给
         桌面, 并把组件重画一遍 —— 那条 grantUriPermission 是内存里的授权, 重启就没了。
         这个接收器**不起 host, 不做开机自启**: 只补授权与重画 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 通讯录 / 短信 / 通话记录 / 日历: 这一版**声明但不实现功能**, 是留着给以后的能力用。
         全部 optional, 因为本应用一件也不做; 侧载安装时系统会在授权页把它们列出来, 不点也不影响
         任何现有功能 -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.WRITE_CALL_LOG" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />

    <!-- 应用可见性: 现在"列应用"靠下面 queries 里那条窄声明, 这条是把整张表都放开。
         声明式, 不触发任何弹窗 -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- 相机、电话、麦克风都是"有也行没有也行"的硬件: 声明成 required=false, 免得设备上没这两样时
         装不上 -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <!-- LW 插件那条路 (批次 9): 伴侣 APK 的 Service 用它护住, 于是只有我们绑得上。
         signature|dangerous 的语义是"满足任一即授予" —— 同签名的伴侣自动拿到, 第三方伴侣要人
         在系统弹窗里点一次同意。我们自己也要 uses-permission 这一条, 否则绑不上护住了的 Service -->
    <permission
        android:name="io.github.yuloong07star.luwi.permission.PLUGIN"
        android:label="@string/permission_plugin_label"
        android:description="@string/permission_plugin_description"
        android:protectionLevel="signature|dangerous" />
    <uses-permission android:name="io.github.yuloong07star.luwi.permission.PLUGIN" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Luwi"
        android:usesCleartextTraffic="true">

        <!-- The QNN runtime talks to the DSP through fastrpc, and libQnnHtpV73Stub.so names
             libcdsprpc.so as a dependency. Since Android 12 the app linker namespace does not
             search /vendor/lib64, and libcdsprpc.so is one of the few vendor libraries published
             for apps, so this declaration is what puts it in reach. Without it QnnDevice_create
             fails with no fastrpc or dsp log to explain why, which is the single most confusing
             way this feature breaks. required=false because the rest of the app runs fine
             without it - OCR is the only consumer and it falls back to the CPU -->
        <uses-native-library
            android:name="libcdsprpc.so"
            android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Luwi"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- specialUse: the host is a long-running local server for an agent, which no other
             foreground service type describes -->
        <service
            android:name=".host.DshHostService"
            android:exported="false"
            android:foregroundServiceType="specialUse|location|camera|microphone|connectedDevice">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="runs the dsh agent host and its Web GUI in the background" />
        </service>

        <!-- 浮在别的应用上面的输入窗: 长跑的前台服务, 类型跟 DshHostService 同一套
             (specialUse 是它自己的理由, microphone 是浮窗里那个 WebView 可能要录音) -->
        <service
            android:name=".overlay.OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse|microphone">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="floats the dsh input window over other apps" />
        </service>

        <!-- 唤醒词: 一直听着麦克风的前台服务。microphone 是它真正要的那一条类型, specialUse 是
             "长跑"这件事本身; 通知栏留一条常驻, 上面一个停止按钮 —— 一直开着的麦克风必须有一眼
             看得见、一下就关得掉的地方 -->
        <service
            android:name=".wake.WakeWordService"
            android:exported="false"
            android:foregroundServiceType="microphone|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="listens for a wake word so the agent can be called by voice" />
        </service>

        <!-- 工作区里的文件要交给别的应用: `lw_share` 与 `lw_open_file` 走 ACTION_SEND / ACTION_VIEW,
             而 Android 10 起 `file://` 一律被拒, 所以交给它们的是这个 provider 发出来的
             `content://`。根目录挂在 `/` 上: 工作区既可能在 /sdcard 也可能是应用自己的媒体目录,
             而这个应用本来就握着 MANAGE_EXTERNAL_STORAGE, root-path 不额外放开任何东西 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.lw.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- How a privileged process returns its binder to this app: it can neither bind to a
             service here nor be handed one, but it can call a provider this app owns. Exported
             because the caller is not this app, and guarded inside by the caller's uid plus a one
             time token, so no other app can attach a privileged process of its own -->
        <provider
            android:name=".channel.LwBootstrapProvider"
            android:authorities="${applicationId}.lw.bootstrap"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false" />

        <!-- Reading what is on a screen, so a caller can name a thing instead of measuring it off
             a picture. Declared here rather than reached over the channel because an accessibility
             service belongs to the app that declares it: the system delivers its callbacks into
             this process, so the tree is readable without a binder and without root.
             It reads the whole device - that is what the service is - so it stays opt in, and the
             settings page can turn it off again -->
        <service
            android:name=".channel.LwAccessibility"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/lw_accessibility" />
        </service>

        <!-- Reading the notification shade. Same shape as the accessibility service and for the same
             reason: the system binds it into this process, so nothing goes over a binder and no
             privileged uid is needed. The gate is the BIND permission, which only the system holds,
             and on top of that the user has to hand this app 通知使用权 in system settings - the
             settings page has a switch for it, because a reinstall takes it away -->
        <service
            android:name=".channel.LwNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Shizuku's own provider, which is how the Shizuku app hands this app the server binder -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false" />

        <!-- 自动指令那条「到点」的条件: 排一个闹钟, 到点由系统把这一条广播送回来 (2.5.0 批次 8)。
             exported=false —— 只有本应用自己的 PendingIntent 叫得动它; 系统在应用进程不在时也会把
             进程拉起来送这一条, 所以"到点"不会因为进程被回收而丢。重启之后监测随 host 服务一起等
             主人打开应用, 这一版不做开机自启 —— 清单里那条 RECEIVE_BOOT_COMPLETED 只给桌面组件
             补授权用 (见 WidgetRegrant), 与监测无关 -->
        <receiver
            android:name=".automation.AutomationAlarmReceiver"
            android:exported="false" />

        <!-- 桌面组件那两个槽 (插件方案 v2 的 3.1): 组件由**主 APK**声明, 插件只往里填内容 ——
             于是"往桌面加一只鲸鱼娘"不再需要第二个 APK。同槽互斥, 一个槽同一时刻只挂一只插件 -->
        <receiver
            android:name=".plugin.widget.WidgetSlotAnim"
            android:exported="false"
            android:label="@string/settings_widget_slot_anim_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lw_widget_slot_anim" />
        </receiver>

        <receiver
            android:name=".plugin.widget.WidgetSlotImage"
            android:exported="false"
            android:label="@string/settings_widget_slot_image_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lw_widget_slot_image" />
        </receiver>

        <!-- 图文槽那两颗按钮里 action: "tool" 那一支: 从桌面点出来, 调插件自己的一条工具 -->
        <receiver
            android:name=".plugin.widget.WidgetActionReceiver"
            android:exported="false" />

        <!-- 开机 / 解锁 / 覆盖安装之后补一轮: 重放帧图的读权限 + 把每个槽重画一遍 -->
        <receiver
            android:name=".plugin.widget.WidgetRegrant"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.USER_UNLOCKED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 帧图 / 配图的只读出口 (方案 3.1): 桌面那一格在启动器进程里画, 图住在我们的私有目录里,
             所以走 content:// 交出去 (位图过 binder 会撞 1 MB 上限); 读权限每一趟组装前重放一次 -->
        <provider
            android:name=".plugin.widget.WidgetFramesProvider"
            android:authorities="io.github.yuloong07star.luwi.lw.widget"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- `inline` 域的宿主 (方案 3.3): 插件与 Luwi 同 uid, 跑在这个独立进程里 ——
             清单里预先声明这一个进程, 一个插件一个 ClassLoader, 插件之间不共享静态状态 -->
        <service
            android:name=".plugin.inline.InlineHostService"
            android:exported="false"
            android:process=":plugin" />
    </application>

    <queries>
        <!-- Shizuku's app is not visible to this one otherwise, on Android 11 and later -->
        <package android:name="moe.shizuku.privileged.api" />
        <!-- What stops every other package being invisible on Android 11 and later: the launcher
             intent is the question "what can a person start", which is narrower than the
             QUERY_ALL_PACKAGES permission on purpose - it is a declaration, not a permission -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- 相机应用: 不声明这一条, `lw_take_photo` 的 `queryIntentActivities` 会**空手而归而相机
             就在那儿** (Android 11 起别的包对它不可见), 于是"这台设备不能拍照"会是一句假话 -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <!-- 语音合成 (TTS) 引擎在 Android 11 起也是可见性问题: 不在这里声明一条, 系统引擎
             对本应用就不可见, TextToSpeech 初始化拿不到默认引擎 -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- 桌面是谁 (方案 3.1): 帧图那条授权要放给"现在正在当桌面"的那几个包, 而 targetSdk 33 起
             不声明这一段就看不见别的包 —— 那是一种静默失败 (组件永远「无法加载」) -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

</manifest>
