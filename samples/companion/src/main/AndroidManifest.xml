<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 伴侣就是"新权限"唯一的合法来源: 它自己要什么就在这里声明什么, LW 一件也代不了 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <!-- 伴侣自带的界面: LW 只给一个"打开"入口 (见协议 10.3), 这一页怎么画是伴侣自己的事。
             **没有 MAIN + LAUNCHER** (方案 3.4 的第一条硬约束): 桌面不许因为装了插件多出一格图标,
             那个 Activity 的名字写在插件包的 `entry.activity` 里, 由 Luwi 用显式组件拉起 -->
        <activity
            android:name=".HelloScreen"
            android:exported="true" />

        <!-- 被 LW 绑的那一个: 用 LW 声明的那条自定义权限护住, 于是别的应用绑不上。
             描述符与 transaction code 都在 :lwplugin-api 里, 这一份是手写 Binder 而不是 AIDL stub -->
        <service
            android:name=".CompanionPluginService"
            android:exported="true"
            android:permission="io.github.yuloong07star.luwi.permission.PLUGIN">
            <intent-filter>
                <action android:name="io.github.yuloong07star.luwi.plugin.BIND" />
            </intent-filter>
        </service>
    </application>

</manifest>
