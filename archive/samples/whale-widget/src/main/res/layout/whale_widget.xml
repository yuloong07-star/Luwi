<?xml version="1.0" encoding="utf-8"?>
<!--
  桌面上那一只: 一台 ViewFlipper (一张一帧, 由它自己翻) 加一枚角落的小标签

  **为什么不用 drawable 动画**: 2026-10-10 在模拟器上实测, `animation-list` 与动态 GIF 两条路都
  停在第一帧 (三秒里 app 一帧都没渲染)。ViewFlipper 的 `autoStart` 是**宿主 inflate 时自己起**的
  (`onAttachedToWindow` 里 `startFlipping`), 与 drawable 动画那条链无关, 所以主路走它
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/whale_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ViewFlipper
        android:id="@+id/whale_flipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:autoStart="true"
        android:flipInterval="100" />

    <TextView
        android:id="@+id/whale_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:background="#66000000"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:textColor="#FFFFFFFF"
        android:textSize="11sp" />

</FrameLayout>
