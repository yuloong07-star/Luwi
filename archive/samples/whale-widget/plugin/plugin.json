{
  "protocol": "lw-plugin/1",
  "id": "io.github.yuloong07star.luwi.sample.whalewidget",
  "name": "鲸鱼娘桌面小组件",
  "version": "1.1.4",
  "minLw": "2.6.0",
  "api": "1",
  "kind": "companion",
  "toolPrefix": "whale",
  "entry": {
    "package": "io.github.yuloong07star.luwi.sample.whalewidget",
    "service": "io.github.yuloong07star.luwi.sample.whalewidget.WhalePluginService",
    "apk": "https://cdn.jsdelivr.net/gh/yuloong07-star/luwi-plugins@whale-widget-1.1.4/packages/whale-widget-1.1.4-companion.zip"
  },
  "capabilities": {
    "requested": [],
    "dangerous": []
  },
  "tools": [
    {
      "name": "whale_list",
      "summary": "看桌面上现在挂的是哪一套鲸鱼娘, 以及一共能切到哪几套 (随包那一套 + 主人自己导进来的那几份)",
      "params": {}
    },
    {
      "name": "whale_next",
      "summary": "把桌面上那只鲸鱼娘换成下一套动作",
      "params": {}
    },
    {
      "name": "whale_set",
      "summary": "把桌面上那只鲸鱼娘换成指定的一套动作 (按键名或序号; 键名从 whale_list 拿)",
      "params": {
        "which": {
          "type": "string",
          "required": true,
          "description": "换哪一套: 随包那三套是 dance-1 / dance-2 / dance-3, 主人导进来的那几份用它们自己的键 (都由 whale_list 列出来); 也可以直接给序号"
        }
      }
    }
  ]
}
